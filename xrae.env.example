# X-Rae credentials and overrides.
#
#   sudo cp xrae.env.example /etc/xrae/xrae.env
#   sudo chown root:xrae     /etc/xrae/xrae.env
#   sudo chmod 640           /etc/xrae/xrae.env
#
# PERMISSIONS: 640 root:xrae, not 600 root:root.
# The service runs as the unprivileged "xrae" user, so it must be able to READ
# this file - 600 owned by root makes the unit start and then fail to
# authenticate, which is a miserable way to spend an hour. Group-read also beats
# making "xrae" the owner: the agent can read its credentials but cannot rewrite
# them. `xrae init` and install.sh both set this for you; the commands above are
# for when you place the file by hand. X-Rae still refuses to start if the file
# is world-readable or group-writable.
#
# WHY SECRETS BELONG HERE AND NOT IN config.json
# A Pterodactyl application key is full panel admin. config.json is the file you
# will end up pasting into a chat when a rule misfires and you want help.
# Keeping credentials out of it means one careless paste does not hand over the
# platform. X-Rae also redacts ptla_/ptlc_ and webhook URLs from its own log
# output for the same reason - but not pasting them at all is better.
#
# ---------------------------------------------------------------------------
# FORMAT WARNING - systemd reads this file, and it is NOT a shell script
# ---------------------------------------------------------------------------
# It silently ignores several things you would expect to work:
#
#   NO   export XRAE_PANEL_APP_KEY=ptla_x     <- "export " becomes part of the name
#   NO   XRAE_PANEL_URL=$SOME_OTHER_VAR       <- no variable expansion
#   NO   XRAE_MODE=observe  # comment here    <- the comment becomes the value
#   YES  XRAE_PANEL_APP_KEY=ptla_x
#
# Comments must start at the beginning of a line. No spaces around the "=".
# Quote a value only if it genuinely contains spaces.
#
# ---------------------------------------------------------------------------
# WHERE THIS FILE GETS LOADED
# ---------------------------------------------------------------------------
# X-Rae looks for "xrae.env" IN THE SAME DIRECTORY AS YOUR config.json and
# loads it automatically. With the default layout that means:
#
#     /etc/xrae/config.json  ->  /etc/xrae/xrae.env
#
# So both of these pick it up with no extra flags:
#
#     xrae doctor --config /etc/xrae/config.json
#     systemctl start xrae
#
# To keep it somewhere else, point at it explicitly:
#
#     XRAE_ENV_FILE=/run/secrets/xrae.env xrae doctor
#
# Variables already present in the real environment WIN over this file, so a
# systemd drop-in or a `VAR=x xrae ...` prefix can override it for one run
# without editing anything.
#
# If a credential ends up in both config.json and here, X-Rae warns you and
# tells you which one it used, rather than picking one quietly.
# ===========================================================================


# --- Required ---------------------------------------------------------------

# Application API key. Needs read access to servers, plus the suspend
# permission only if you ever intend to enable enforce mode.
XRAE_PANEL_APP_KEY=ptla_replace_me


# --- Optional, but you probably want these ---------------------------------

# Client API key. Enables the CPU behaviour evidence family. Without it
# "collectCpu" is inactive, and doctor will tell you so instead of pretending.
#XRAE_PANEL_CLIENT_KEY=ptlc_replace_me

# Discord webhook. REQUIRED before X-Rae will start in throttle or enforce
# mode: acting on a customer's server with nobody notified is silent
# enforcement, and the config validator refuses to allow it.
#XRAE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000/replace_me


# --- X-Rae control panel (optional) -----------------------------------------
# Reporting to the panel at xrae.raehost.com. Set BOTH or NEITHER: a URL with no
# token, or a token with no URL, is refused at startup rather than silently
# never reporting, because "this node is quiet" is the one thing the panel must
# never get wrong.
#
# install.sh writes both for you from --panel and --token. The token is issued
# once when you create the node in the panel and is stored there only as a hash,
# so if you lose it, rotate rather than hunt for it.
#
# Losing the panel costs telemetry, never protection: the agent keeps scanning
# and enforcing locally when reporting fails.

#XRAE_REPORTING_URL=https://xrae.raehost.com
#XRAE_REPORTING_TOKEN=xrae_node_replace_me


# --- Overrides for things that normally live in config.json ------------------
# Handy for deploying one shared config across several nodes, or for testing
# without editing the file. Anything set here wins over config.json.

#XRAE_PANEL_URL=https://panel.example.com

# Which node this agent is responsible for. 0 = every node the key can see.
# This is the one to set per host if you ship one config file to a whole fleet.
#XRAE_NODE_ID=0

#XRAE_VOLUMES_PATH=/var/lib/pterodactyl/volumes

# observe | alert | throttle | enforce   -- read the README before changing.
#XRAE_MODE=observe

# error | warn | info | debug
#XRAE_LOG_LEVEL=info

#XRAE_STATE_PATH=/var/lib/x-rae/state.json

# Default config path, so you can drop --config from every command.
#XRAE_CONFIG=/etc/xrae/config.json

# Load the env file from somewhere other than next to config.json. Useful when
# secrets are mounted at runtime, e.g. /run/secrets. Chicken-and-egg note: this
# one has to be a real environment variable, since it decides which file to
# read - setting it inside that file does nothing.
#XRAE_ENV_FILE=/etc/xrae/xrae.env
