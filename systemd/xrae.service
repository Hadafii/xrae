[Unit]
Description=X-Rae abuse detection agent
Documentation=file:/opt/xrae/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=xrae
Group=xrae
WorkingDirectory=/opt/xrae

# Self-heal the credentials file's permissions on every start. Editing
# xrae.env as root (e.g. with an editor) can reset it to root:root, after which
# the unprivileged service user can no longer read it and the agent fails with
# EACCES. The "+" prefix runs this as root, outside the sandbox below, so it can
# fix ownership in /etc; the guard makes it a no-op when the file is absent.
ExecStartPre=+/bin/sh -c 'test -f /etc/xrae/xrae.env && chown root:xrae /etc/xrae/xrae.env && chmod 640 /etc/xrae/xrae.env || true'

# @NODE_BIN@ is substituted by install.sh. Hardcoding /usr/bin/node meant any
# node using nvm, snap or /usr/local/bin failed 203/EXEC in a restart loop while
# the installer reported success.
ExecStart=@NODE_BIN@ /opt/xrae/bin/xrae run --config /etc/xrae/config.json

# Credentials live here, not in config.json.
EnvironmentFile=-/etc/xrae/xrae.env

Restart=on-failure
RestartSec=15s
TimeoutStopSec=90s

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
# X-Rae needs to READ files it does not own, and nothing else. It never writes
# outside its state directory and never executes anything.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately ABSENT. Node cannot run under it:
# V8's JIT dies on a fatal SetPermissions check, and --jitless is no escape
# because fetch (undici) then fails on its WebAssembly HTTP parser. Both were
# hit in production before this comment existed. The seccomp filter,
# NoNewPrivileges, ProtectSystem=strict and the two-capability set above are
# the compensating controls. Re-adding W^X would mean dropping fetch for
# node:https first - see the open-work list in CLAUDE.md.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module

# The only writable path.
StateDirectory=xrae
StateDirectoryMode=0750
ReadWritePaths=/var/lib/xrae

# Read-only view of what we scan. @VOLUMES_PATH@ is substituted by install.sh
# from Wings' own config, and the leading "-" makes a missing path non-fatal:
# without it systemd refuses to start the unit at all (226/NAMESPACE) on any node
# whose Wings data lives somewhere else, and the agent never scans anything.
ReadOnlyPaths=-@VOLUMES_PATH@

# ---------------------------------------------------------------------------
# Capabilities - deliberately just two, instead of root
# ---------------------------------------------------------------------------
#   CAP_DAC_READ_SEARCH  read volume files owned by the pterodactyl user
#   CAP_SYS_PTRACE       read /proc/<pid>/net to attribute connections to the
#                        correct container
#
# If you would rather not grant CAP_SYS_PTRACE, remove it from both lines below
# and set "collectConnections": false in the config. Everything else keeps
# working; you simply lose one evidence family.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

# ---------------------------------------------------------------------------
# Resource ceilings, so a pathological volume cannot take the node down
# ---------------------------------------------------------------------------
CPUQuota=50%
MemoryMax=512M
IOWeight=50
Nice=10

[Install]
WantedBy=multi-user.target
