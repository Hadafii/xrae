// X-Rae settings.
//
// Comments are allowed here. Anything you leave out uses its default -
// run "xrae doctor" to see the values actually in effect.
//
// CREDENTIALS DO NOT BELONG IN THIS FILE.
// They live in xrae.env, next to this file. See xrae.env.example.
// Precedence, highest first:
//     real environment  ->  xrae.env  ->  this file  ->  defaults
//
// You CAN put keys here and it will work, but then this file becomes a secret
// too and X-Rae will refuse to start unless it is mode 0600.
{
  "panel": {
    "url": "https://panel.example.com"
  },

  "scanner": {
    "volumesPath": "/var/lib/pterodactyl/volumes",
    "nodeId": 0,
    "intervalMinutes": 15,

    // Needs XRAE_PANEL_CLIENT_KEY.
    "collectCpu": true,

    // Needs permission to read /proc/<pid>/net (CAP_SYS_PTRACE).
    // Set to false if you would rather not grant that capability.
    "collectConnections": true
  },

  "policy": {
    // observe   record only, touch nothing        <-- START HERE
    // alert     tell humans, touch nothing
    // throttle  may reduce CPU, never suspend
    // enforce   may suspend, with all guardrails
    "mode": "observe",

    "riskThreshold": 100,
    "minConfidenceToSuspend": "critical",

    // Must trip this many cycles in a row before any action is taken.
    "consecutiveDetections": 2,

    // Hard ceiling on actions per cycle. A bad rule cannot cascade past this.
    "maxActionsPerCycle": 3,

    // If more than this fraction of the node trips in one cycle, X-Rae assumes
    // it is broken rather than that everyone started mining, halts all action,
    // and calls the operator.
    "anomalyAbortRatio": 0.25,

    // Evidence fades. Without this, weak noise accumulates its way to a
    // suspension eventually - which is a timer, not a detector.
    "scoreHalfLifeHours": 24,

    // Where throttle mode caps CPU, as a percentage of the server's own limit.
    "throttleToCpuPercent": 25
  },

  "exclusions": {
    // Turn off a rule:                 ["tunnel.nezha.agent"]
    "ruleIds": [],
    // Never open a file by name:       ["blocklist.txt"]
    "fileNames": [],
    // Skip an extension:               ["bak", "dump"]
    "extensions": [],
    // Skip a path inside every volume: ["plugins/HugePlugin"]
    "relativePaths": []
  },

  "state": {
    "path": "/var/lib/x-rae/state.json"
  }
}
